---
/**
 * El escritorio jugable: DOS sesiones de Claude, cada una con su terminal y su
 * bichito. Arrastralos por separado, clickeá uno y su terminal pasa al frente,
 * abriles el menú (ocultar solo ese, ir a esa terminal), prendé y apagá cosas
 * en el panel, y mandale trabajo a cualquiera de las dos.
 *
 * Es la hero de la página a propósito: contar por escrito qué hace una mascota
 * de escritorio es peor que dejar que la manotees.
 */
import meta from "../../public/sprites/meta.json";

const ALTO = 150;
const escala = ALTO / meta.h;
const ANCHO = Math.round(meta.w * escala);

const sesiones = [
  { id: "uno", proyecto: "Claude bichito", vent: "term", x: "58%", y: "6%" },
  { id: "dos", proyecto: "smart-campus", vent: "term2", x: "58%", y: "50%" },
];

const toggles = [
  { id: "pet", label: "Bichitos flotantes" },
  { id: "timer", label: "Cronómetro" },
  { id: "voz", label: "Voz" },
  { id: "centrar", label: "Saltar al centro" },
  { id: "encima", label: "Siempre encima" },
  { id: "plan5", label: "% plan 5h" },
  { id: "planSem", label: "% plan semanal" },
];
---

<div class="esc" data-esc>
  <div class="esc__marco">
    <div class="esc__pantalla" data-pantalla>
      <div class="esc__fondo" aria-hidden="true"></div>

      <article class="vent vent--term esc-activa" data-vent="term">
        <header class="vent__barra" data-mover="term">
          <span class="vent__semaforo" aria-hidden="true"></span>
          <span class="vent__tit mini">claude — Claude bichito</span>
        </header>
        <div class="vent__cuerpo" data-consola="term" role="log" aria-live="polite"></div>
      </article>

      <article class="vent vent--term2" data-vent="term2">
        <header class="vent__barra" data-mover="term2">
          <span class="vent__semaforo" aria-hidden="true"></span>
          <span class="vent__tit mini">claude — smart-campus</span>
        </header>
        <div class="vent__cuerpo" data-consola="term2" role="log"></div>
      </article>

      <article class="vent vent--panel" data-vent="panel" hidden>
        <header class="vent__barra" data-mover="panel">
          <span class="vent__semaforo" aria-hidden="true"></span>
          <span class="vent__tit mini">Bichito — panel</span>
          <button class="vent__cerrar" data-cerrar-panel aria-label="Cerrar el panel">×</button>
        </header>
        <div class="vent__cuerpo vent__cuerpo--panel">
          <ul class="panel__lista">
            {
              toggles.map(({ id, label }) => (
                <li class="panel__fila">
                  <label class="panel__label">
                    <input type="checkbox" data-cfg={id} />
                    <span class="panel__pista" aria-hidden="true"><span class="panel__perilla" /></span>
                    <span>{label}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      {
        sesiones.map((s) => (
          <div
            class="bic"
            data-bic={s.id}
            style={`--bx:${s.x};--by:${s.y}`}
            role="button"
            tabindex="0"
            aria-label={`El bichito de ${s.proyecto}. Clickealo para ir a su terminal, arrastralo para moverlo, botón derecho para el menú.`}
          >
            <div class="bic__sprite sprite pixel" data-sprite style={`width:${ANCHO}px;height:${ALTO}px`} />
            <div class="bic__texto">
              <span class="bic__proyecto hud hud-sombra">{s.proyecto}</span>
              <span class="bic__label hud hud-sombra" data-label />
              <span class="bic__uso hud hud-sombra" data-uso />
            </div>
          </div>
        ))
      }

      <div class="globo mini" data-globo hidden></div>

      <ul class="menu" data-menu hidden role="menu">
        <li><button role="menuitem" data-menu-item="terminal">Ir a esta terminal</button></li>
        <li><button role="menuitem" data-menu-item="panel">Abrir panel</button></li>
        <li><button role="menuitem" data-menu-item="encima">Siempre encima <span data-menu-encima>sí</span></button></li>
        <li class="menu__raya" role="separator"></li>
        <li><button role="menuitem" data-menu-item="juntos">Mover todos juntos <span data-menu-juntos>no</span></button></li>
        <li><button role="menuitem" data-menu-item="ocultar">Ocultar este</button></li>
        <li><button role="menuitem" data-menu-item="mostrar">Mostrar todos</button></li>
      </ul>

      <footer class="barra">
        <button class="barra__bandeja" data-bandeja>
          <span class="barra__icono pixel" aria-hidden="true"></span>
          <span class="mini" data-bandeja-txt>Bichito</span>
        </button>
        <span class="barra__reloj mini" data-reloj></span>
      </footer>
    </div>
  </div>

  <div class="mando">
    <div class="mando__grupo">
      <span class="mando__titulo mini">Claude bichito</span>
      <button class="btn btn--clay" data-accion="turno">Pedile una tarea</button>
      <button class="btn" data-accion="pregunta">Que te pregunte</button>
    </div>
    <div class="mando__grupo">
      <span class="mando__titulo mini">smart-campus</span>
      <button class="btn" data-accion="otro">Que te pregunte el otro</button>
    </div>
  </div>

  <p class="esc__pie">
    Arrastralos por separado (o con Ctrl, a todos juntos) · clickeá uno para ir
    a su terminal · botón derecho para el menú
  </p>
</div>

<style is:global>
  /* ==================================================================== */
  /*  El escritorio. Todo el CSS del componente va global porque el guion  */
  /*  crea nodos (líneas de consola, chispas) que no llevan el atributo    */
  /*  de scope de Astro y con estilos scopeados quedarían sin pintar.      */
  /* ==================================================================== */
  .esc {
    --marco: 0.75rem;
  }

  .esc__marco {
    border: 1px solid var(--color-ink-line);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #221c16, #171310);
    padding: var(--marco);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 60px -30px rgb(0 0 0 / 0.9);
  }

  .esc__pantalla {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #0f0d0b;
    height: clamp(27rem, 46vw, 33rem);
    user-select: none;
  }

  /* el fondo de pantalla: brasa arriba a la derecha, grilla de píxeles y viñeta */
  .esc__fondo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 88% 8%, #d9775726 0%, transparent 70%),
      radial-gradient(70% 60% at 10% 100%, #f0b4291a 0%, transparent 65%),
      linear-gradient(160deg, #191410 0%, #0e0c0a 100%);
  }
  .esc__fondo::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, #ffffff08 1px, transparent 1px),
      linear-gradient(to bottom, #ffffff08 1px, transparent 1px);
    background-size: 16px 16px;
    mask-image: radial-gradient(80% 70% at 50% 40%, #000 0%, transparent 100%);
  }

  /* --------------------------------------------------------- ventanas -- */
  .vent {
    position: absolute;
    left: var(--x, 1.5rem);
    top: var(--y, 1.5rem);
    width: var(--w, min(29rem, 52%));
    border: 1px solid var(--color-slate-line);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-slate) 92%, transparent);
    backdrop-filter: blur(2px);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.85);
    z-index: 10;
    transition: box-shadow 0.2s, border-color 0.2s, opacity 0.2s;
    opacity: 0.72;
  }
  .vent.esc-activa {
    z-index: 20;
    opacity: 1;
    border-color: color-mix(in srgb, var(--color-clay) 55%, var(--color-slate-line));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-clay) 25%, transparent),
      0 28px 56px -20px rgb(0 0 0 / 0.9);
  }
  .vent--term2 {
    --x: 2.5rem;
    --y: 15.5rem;
    --w: min(24rem, 46%);
  }

  .vent__barra {
    touch-action: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--color-slate-line);
    background: var(--color-slate-soft);
    border-radius: 0.55rem 0.55rem 0 0;
    cursor: grab;
  }
  .vent__barra:active {
    cursor: grabbing;
  }
  .vent__semaforo {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-ash);
    box-shadow: 0.75rem 0 0 #3b4350, 1.5rem 0 0 #3b4350;
    margin-right: 1.5rem;
  }
  .vent__tit {
    color: var(--color-ash);
  }
  .esc-activa .vent__semaforo {
    background: var(--color-clay);
  }
  .esc-activa .vent__tit {
    color: var(--color-cream);
  }
  .vent__cerrar {
    margin-left: auto;
    color: var(--color-ash);
    line-height: 1;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
  }
  .vent__cerrar:hover {
    color: var(--color-cream);
    background: #ffffff12;
  }

  .vent__cuerpo {
    padding: 0.8rem 0.9rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: #b9c2cd;
    height: 11rem;
    overflow: hidden auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-slate-line) transparent;
  }
  .vent--term2 .vent__cuerpo {
    height: 7rem;
  }
  .vent__cuerpo--panel {
    height: auto;
    font-family: var(--font-sans);
    color: var(--color-cream);
  }

  /* líneas de la consola */
  .lin {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .lin--user {
    color: var(--color-cream);
  }
  .lin--user::before {
    content: "› ";
    color: var(--color-clay);
  }
  .lin--tool {
    color: #7d8a99;
  }
  .lin--tool b {
    color: #9db1c7;
    font-weight: 400;
  }
  .lin--ok {
    color: #86b06f;
  }
  .lin--hook {
    color: var(--color-clay);
    opacity: 0.75;
    font-size: 0.6875rem;
  }
  .lin--preg {
    margin: 0.4rem 0 0.2rem;
    padding: 0.55rem 0.7rem;
    border-left: 2px solid var(--color-clay);
    background: #d9775714;
    color: var(--color-cream);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.35rem 0 0.2rem;
  }
  .opcion {
    border: 1px solid var(--color-slate-line);
    border-radius: 0.4rem;
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-cream);
    background: #ffffff08;
  }
  .opcion:hover {
    border-color: var(--color-clay);
    color: var(--color-clay-soft);
  }

  /* ----------------------------------------------------------- panel -- */
  .vent--panel {
    --w: min(17rem, 50%);
    --x: 54%;
    --y: 3rem;
  }
  .panel__lista {
    display: grid;
    gap: 0.15rem;
  }
  .panel__fila {
    border-radius: 0.4rem;
  }
  .panel__fila:hover {
    background: #ffffff08;
  }
  .panel__label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.4rem;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .panel__label input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .panel__pista {
    width: 1.85rem;
    height: 1.05rem;
    border-radius: 999px;
    background: #ffffff14;
    border: 1px solid var(--color-slate-line);
    display: inline-flex;
    align-items: center;
    padding: 0 2px;
    transition: background 0.15s, border-color 0.15s;
    flex: none;
  }
  .panel__perilla {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--color-ash);
    transition: transform 0.15s, background 0.15s;
  }
  .panel__label input:checked + .panel__pista {
    background: color-mix(in srgb, var(--color-clay) 35%, transparent);
    border-color: var(--color-clay);
  }
  .panel__label input:checked + .panel__pista .panel__perilla {
    transform: translateX(0.8rem);
    background: var(--color-clay);
  }
  .panel__label input:focus-visible + .panel__pista {
    outline: 2px solid var(--color-clay);
    outline-offset: 2px;
  }

  /* -------------------------------------------------------- bichitos -- */
  .bic {
    touch-action: none;
    position: absolute;
    left: var(--bx, 58%);
    top: var(--by, 8%);
    z-index: 30;
    display: grid;
    justify-items: center;
    cursor: grab;
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.55));
  }
  .bic[data-atras="1"] {
    z-index: 5;
  }
  .bic:active {
    cursor: grabbing;
  }
  .bic[hidden] {
    display: none;
  }
  /* mientras te espera, un resplandor que respira: es lo que en la app hace el
     salto al centro, llamarte la atención sin taparte nada */
  .bic::before {
    content: "";
    position: absolute;
    inset: -25% -30%;
    background: radial-gradient(circle at 50% 42%, #d9775745, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .bic[data-espera="1"]::before {
    opacity: 1;
    animation: latir 2.4s ease-in-out infinite;
  }
  @keyframes latir {
    50% {
      opacity: 0.4;
    }
  }
  /* si uno te espera, los demás pasan a segundo plano */
  .bic[data-apagado="1"] .bic__sprite,
  .bic[data-apagado="1"] .bic__texto {
    opacity: 0.5;
  }
  .bic__texto {
    display: grid;
    justify-items: center;
    gap: 1px;
    margin-top: -2px;
    pointer-events: none;
  }
  .bic__proyecto {
    font-size: 0.8125rem;
    color: var(--color-cream);
  }
  .bic[data-espera="1"] .bic__proyecto {
    color: var(--color-clay-soft);
  }
  .bic__label {
    font-size: 0.75rem;
    color: #cabaac;
  }
  .bic__uso {
    font-size: 0.75rem;
    color: var(--color-tan);
    letter-spacing: 0.04em;
  }
  .bic:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 6px;
    border-radius: 0.5rem;
  }

  /* chispas del festejo */
  .chispa {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--color-ember);
    z-index: 29;
    animation: chispa 0.9s ease-out forwards;
  }
  @keyframes chispa {
    to {
      transform: translate(var(--dx), var(--dy)) scale(0.4);
      opacity: 0;
    }
  }

  /* ------------------------------------------------------ globo y menú */
  .globo {
    position: absolute;
    z-index: 40;
    max-width: 16rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--color-ink-line);
    border-radius: 0.5rem;
    background: #241d17f2;
    color: var(--color-cream);
    line-height: 1.5;
    pointer-events: none;
  }
  .globo[hidden] {
    display: none;
  }
  .globo::before {
    content: "♪ ";
    color: var(--color-clay);
  }

  .menu {
    position: absolute;
    z-index: 50;
    min-width: 11rem;
    padding: 0.25rem;
    border: 1px solid var(--color-ink-line);
    border-radius: 0.5rem;
    background: #221c16f5;
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.9);
  }
  .menu[hidden] {
    display: none;
  }
  .menu button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-radius: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-cream);
  }
  .menu button:hover {
    background: var(--color-clay);
    color: var(--color-ink);
  }
  .menu__raya {
    height: 1px;
    margin: 0.25rem 0.3rem;
    background: var(--color-ink-line);
  }

  /* ---------------------------------------------------------- barra --- */
  .barra {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.6rem;
    background: #0d0b09d9;
    border-top: 1px solid #ffffff10;
    backdrop-filter: blur(4px);
  }
  .barra__bandeja {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--color-ash);
  }
  .barra__bandeja:hover {
    background: #ffffff10;
    color: var(--color-cream);
  }
  .barra__icono {
    width: 14px;
    height: 14px;
    background: url("/favicon.png") center / contain no-repeat;
  }
  .barra__reloj {
    color: var(--color-ash);
  }

  /* ----------------------------------------------------------- mando -- */
  .mando {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.1rem;
  }
  .mando__grupo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .mando__titulo {
    color: var(--color-ash);
    margin-right: 0.15rem;
  }

  .btn {
    border: 1px solid var(--color-ink-line);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-cream);
    background: var(--color-ink-soft);
    transition: border-color 0.15s, color 0.15s, transform 0.1s;
  }
  .btn:hover {
    border-color: var(--color-clay);
    color: var(--color-clay-soft);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--clay {
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: #1a120d;
    font-weight: 600;
  }
  .btn--clay:hover {
    filter: brightness(1.08);
    color: #1a120d;
  }

  .esc__pie {
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }

  @media (max-width: 640px) {
    .vent--term {
      --w: 84%;
    }
    .vent--term2 {
      --w: 70%;
      --y: 13rem;
    }
    .vent__cuerpo {
      height: 8.5rem;
    }
    .vent--term2 .vent__cuerpo {
      height: 5.5rem;
    }
    .vent--panel {
      --w: 74%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chispa {
      display: none;
    }
  }
</style>

<script define:vars={{ meta, ALTO, ANCHO, sesiones }}>
  (() => {
    const esc = document.querySelector("[data-esc]");
    if (!esc) return;

    const pantalla = esc.querySelector("[data-pantalla]");
    const menu = esc.querySelector("[data-menu]");
    const globo = esc.querySelector("[data-globo]");
    const panel = esc.querySelector('[data-vent="panel"]');
    const reloj = esc.querySelector("[data-reloj]");
    const bandejaTxt = esc.querySelector("[data-bandeja-txt]");
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const TEXTO = { cocinando: "Cocinando", esperando: "Te espera", termino: "Listo", dormido: "" };
    const cfg = { pet: true, timer: true, voz: false, centrar: true, encima: true,
                  plan5: true, planSem: true, juntos: false };

    const fmt = (s) => {
      s = Math.max(0, Math.floor(s));
      return s >= 60 ? `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, "0")}s` : `${s}s`;
    };
    let timers = [];
    const luego = (fn, ms) => timers.push(setTimeout(fn, ms));
    const limpiar = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    // -------------------------------------------------------- un bichito
    class Bicho {
      constructor(def) {
        Object.assign(this, def);
        this.el = esc.querySelector(`[data-bic="${def.id}"]`);
        this.sprite = this.el.querySelector("[data-sprite]");
        this.elLabel = this.el.querySelector("[data-label]");
        this.elUso = this.el.querySelector("[data-uso]");
        this.ventId = def.vent;   // el id; abajo se pisa con el elemento
        this.vent = esc.querySelector(`[data-vent="${def.vent}"]`);
        this.consola = esc.querySelector(`[data-consola="${def.vent}"]`);
        this.estado = "dormido";
        this.desde = 0;
        this.congelado = "";
        this.pinned = false;
        this.oculto = false;
        this.primero = false;
        this.corriendo = false;
        this.pos = { x: 0, y: 0 };
        this.home = { x: 0, y: 0 };
        this.pintarSprite();
      }

      medidas() {
        const p = pantalla.getBoundingClientRect();
        return {
          w: p.width,
          h: p.height,
          ancho: this.el.offsetWidth || ANCHO,
          alto: this.el.offsetHeight || ALTO + 50,
        };
      }

      poner(x, y) {
        const m = this.medidas();
        this.pos = {
          x: Math.min(Math.max(x, 4), m.w - m.ancho - 4),
          y: Math.min(Math.max(y, 4), m.h - m.alto - 26),
        };
        this.el.style.setProperty("--bx", `${this.pos.x}px`);
        this.el.style.setProperty("--by", `${this.pos.y}px`);
      }

      /** Pasa de la posición en % del HTML a píxeles, para poder arrastrarlo. */
      acomodar() {
        const r = this.el.getBoundingClientRect();
        const p = pantalla.getBoundingClientRect();
        this.poner(r.left - p.left, r.top - p.top);
        this.home = { ...this.pos };
      }

      pintarSprite() {
        const info = meta[this.estado];
        this.sprite.style.backgroundImage = `url(/sprites/${this.estado}.png)`;
        this.sprite.style.setProperty("--strip", `${ANCHO * info.frames}px`);
        this.sprite.style.setProperty("--frames", info.frames);
        this.sprite.style.setProperty("--dur", `${(info.frames / info.fps).toFixed(2)}s`);
        this.sprite.classList.toggle("sprite--once", this.estado === "termino");
        this.sprite.style.animation = "none";
        void this.sprite.offsetWidth;
        this.sprite.style.animation = "";
      }

      pintarTexto() {
        let label = "";
        if (this.estado === "termino") {
          label = cfg.timer && this.congelado ? `Listo  ${this.congelado}` : "Listo";
        } else {
          const base = TEXTO[this.estado] || "";
          label = base && this.desde && cfg.timer ? `${base}  ${fmt((Date.now() - this.desde) / 1000)}` : base;
        }
        this.elLabel.textContent = label;
        // el % del plan es de la cuenta, no de una sesión: lo lleva el primero
        const partes = [];
        if (this.primero) {
          if (cfg.plan5) partes.push("5h 24%");
          if (cfg.planSem) partes.push("sem 78%");
        }
        this.elUso.textContent = partes.join("  ");
      }

      set(nuevo, opciones = {}) {
        if (nuevo !== this.estado) {
          if (nuevo !== "esperando") this.pinned = false;
          this.estado = nuevo;
          this.el.dataset.espera = nuevo === "esperando" ? "1" : "0";
          this.pintarSprite();
        }
        if (nuevo === "cocinando" && !opciones.mantener) this.desde = Date.now();
        if (nuevo === "dormido") this.desde = 0;
        this.pintarTexto();
        apagarLosQueNoEsperan();
      }

      /** Solo el que te espera se va al centro: si saltaran los dos, taparían
       *  la pantalla entera (en la app pasa lo mismo con seis). */
      deslizar() {
        let destino = this.home;
        if (this.estado === "esperando" && cfg.centrar && !this.pinned) {
          const m = this.medidas();
          destino = { x: (m.w - m.ancho) / 2, y: (m.h - m.alto) / 2 - 10 };
        }
        const dx = destino.x - this.pos.x;
        const dy = destino.y - this.pos.y;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) this.poner(destino.x, destino.y);
        else this.poner(this.pos.x + dx * (quieto ? 1 : 0.18), this.pos.y + dy * (quieto ? 1 : 0.18));
      }

      linea(clase, html) {
        const p = document.createElement("p");
        p.className = `lin lin--${clase}`;
        p.innerHTML = html;
        this.consola.appendChild(p);
        this.consola.scrollTop = this.consola.scrollHeight;
      }

      aplicarVisibilidad() {
        this.el.hidden = this.oculto || !cfg.pet;
      }
    }

    const bichos = sesiones.map((s) => new Bicho(s));
    bichos[0].primero = true;

    function apagarLosQueNoEsperan() {
      const hayEspera = bichos.some((b) => b.estado === "esperando");
      bichos.forEach((b) => {
        b.el.dataset.apagado = hayEspera && b.estado !== "esperando" ? "1" : "0";
      });
    }

    function activar(cual) {
      esc.querySelectorAll("[data-vent]").forEach((v) => {
        v.classList.toggle("esc-activa", v.dataset.vent === cual);
      });
    }

    function globito(bicho, texto, ms) {
      globo.textContent = texto;
      globo.hidden = false;
      const m = bicho.medidas();
      globo.style.left = `${Math.max(Math.min(bicho.pos.x - 20, m.w - 270), 8)}px`;
      globo.style.top = `${Math.max(bicho.pos.y - 34, 6)}px`;
      luego(() => (globo.hidden = true), ms);
    }

    function decir(bicho, texto) {
      globito(bicho, texto, 3400);
      if (cfg.voz && "speechSynthesis" in window) {
        try {
          const v = new SpeechSynthesisUtterance(texto);
          v.lang = "es-AR";
          v.rate = 1.05;
          speechSynthesis.cancel();
          speechSynthesis.speak(v);
        } catch {
          /* si el navegador no quiere hablar, queda el globo */
        }
      }
    }

    // --------------------------------------------------------- el guion
    const TAREA = [
      { c: "tool", t: "<b>Read</b>  bichito_pet.py" },
      { c: "tool", t: "<b>Grep</b>  _draw_text" },
      { c: "tool", t: "<b>Edit</b>  bichito_pet.py  +12 −4" },
      { c: "tool", t: "<b>Bash</b>  python build.py" },
    ];

    function correrTurno(bicho, conPregunta) {
      if (bicho.corriendo) return;
      limpiar();
      bicho.corriendo = true;
      bicho.consola.innerHTML = "";
      bicho.linea("user", conPregunta ? "arreglá el layout del % del plan" : "compilá y dejámelo instalado");
      bicho.linea("hook", "UserPromptSubmit → bichito-hook.exe working");
      bicho.set("cocinando");
      activar(bicho.ventId);

      let t = 500;
      TAREA.forEach((l, i) => {
        luego(() => {
          bicho.linea(l.c, l.t);
          bicho.linea("hook", "PreToolUse → working");
        }, t);
        t += 800;
        if (conPregunta && i === 1) {
          luego(() => preguntar(bicho), t);
          t += 400;
        }
      });
      if (!conPregunta) luego(() => terminar(bicho), t + 300);
    }

    function preguntar(bicho) {
      // en la app esto lo dispara el PreToolUse de AskUserQuestion
      limpiar();
      bicho.linea("hook", "PreToolUse AskUserQuestion → waiting");
      bicho.linea("preg", "¿La franja del uso va abajo del label, o arriba?");
      const caja = document.createElement("div");
      caja.className = "opciones";
      ["Abajo", "Arriba"].forEach((op) => {
        const b = document.createElement("button");
        b.className = "opcion";
        b.textContent = op;
        b.addEventListener("click", () => {
          caja.remove();
          bicho.linea("user", op.toLowerCase());
          bicho.set("cocinando", { mantener: true });
          bicho.linea("hook", "UserPromptSubmit → working");
          luego(() => bicho.linea("tool", "<b>Edit</b>  bichito_pet.py  +8 −3"), 600);
          luego(() => terminar(bicho), 1600);
        });
        caja.appendChild(b);
      });
      bicho.consola.appendChild(caja);
      bicho.consola.scrollTop = bicho.consola.scrollHeight;
      bicho.set("esperando", { mantener: true });
      decir(bicho, `El proyecto ${bicho.proyecto} está esperando tu respuesta`);
    }

    function terminar(bicho) {
      bicho.congelado = fmt((Date.now() - bicho.desde) / 1000);
      bicho.linea("ok", "listo");
      bicho.linea("hook", "Stop → bichito-hook.exe idle");
      bicho.set("termino");
      decir(bicho, `El proyecto ${bicho.proyecto} terminó`);
      chispas(bicho);
      luego(() => {
        bicho.set("dormido");
        bicho.corriendo = false;
      }, 2400);
    }

    function chispas(bicho) {
      if (quieto) return;
      const m = bicho.medidas();
      for (let i = 0; i < 14; i++) {
        const c = document.createElement("i");
        c.className = "chispa";
        c.style.left = `${bicho.pos.x + m.ancho / 2}px`;
        c.style.top = `${bicho.pos.y + 40}px`;
        c.style.setProperty("--dx", `${(Math.random() - 0.5) * 150}px`);
        c.style.setProperty("--dy", `${-Math.random() * 110 - 20}px`);
        c.style.animationDelay = `${Math.random() * 0.25}s`;
        pantalla.appendChild(c);
        setTimeout(() => c.remove(), 1300);
      }
    }

    // ------------------------------------------------------- arrastrar
    function arrastrable(el, alClick, bicho) {
      let id = null;
      let ini = null;
      let movido = false;
      let grupo = false;
      let inicio = null;
      el.addEventListener("pointerdown", (e) => {
        if (e.button === 2) return;
        id = e.pointerId;
        movido = false;
        const r = el.getBoundingClientRect();
        const p = pantalla.getBoundingClientRect();
        // con Ctrl (o el modo del menú) se arrastran todos juntos, como en la app
        grupo = !!bicho && (e.ctrlKey || e.metaKey || cfg.juntos);
        inicio = grupo ? Object.fromEntries(bichos.map((b) => [b.id, { ...b.home }])) : null;
        ini = { dx: e.clientX - r.left, dy: e.clientY - r.top, px: p.left, py: p.top, x: e.clientX, y: e.clientY };
        try {
          el.setPointerCapture(id);
        } catch {
          /* sin captura anda igual mientras el puntero no se escape */
        }
      });
      el.addEventListener("pointermove", (e) => {
        if (id === null || e.pointerId !== id) return;
        if (!movido) {
          // el mismo umbral que la app: un click nunca sale perfectamente quieto
          if (Math.abs(e.clientX - ini.x) < 4 && Math.abs(e.clientY - ini.y) < 4) return;
          movido = true;
        }
        const x = e.clientX - ini.px - ini.dx;
        const y = e.clientY - ini.py - ini.dy;
        if (grupo) {
          const dx = e.clientX - ini.x;
          const dy = e.clientY - ini.y;
          bichos.forEach((b) => {
            const p0 = inicio[b.id];
            b.poner(p0.x + dx, p0.y + dy);
            b.home = { ...b.pos };
            b.pinned = true;
          });
        } else if (bicho) {
          bicho.poner(x, y);
          bicho.home = { ...bicho.pos };
          bicho.pinned = true;   // arrastrar gana: el centro deja de tironear
        } else {
          el.style.setProperty("--x", `${x}px`);
          el.style.setProperty("--y", `${y}px`);
        }
      });
      const soltar = (e) => {
        if (id === null || (e.pointerId !== undefined && e.pointerId !== id)) return;
        try {
          el.releasePointerCapture(id);
        } catch {}
        id = null;
        if (!movido && alClick) alClick();
      };
      el.addEventListener("pointerup", soltar);
      el.addEventListener("pointercancel", soltar);
    }

    function irALaTerminal(bicho) {
      activar(bicho.ventId);
      bicho.vent.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.012)" }, { transform: "scale(1)" }],
        { duration: 260, easing: "ease-out" },
      );
      globito(bicho, `click → al frente la terminal de ${bicho.proyecto}`, 2600);
    }

    bichos.forEach((b) => {
      arrastrable(b.el, () => irALaTerminal(b), b);
      b.el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          irALaTerminal(b);
        }
      });
      b.el.addEventListener("contextmenu", (e) => abrirMenu(e, b));
    });

    esc.querySelectorAll("[data-mover]").forEach((barra) => {
      const vent = barra.closest(".vent");
      arrastrable(barra, () => activar(vent.dataset.vent), null);
      vent.addEventListener("pointerdown", () => activar(vent.dataset.vent));
    });

    // ------------------------------------------------------------ menú
    let objetivo = null;
    function abrirMenu(e, bicho) {
      e.preventDefault();
      objetivo = bicho;
      const p = pantalla.getBoundingClientRect();
      menu.style.left = `${Math.min(e.clientX - p.left, p.width - 190)}px`;
      menu.style.top = `${Math.min(e.clientY - p.top, p.height - 180)}px`;
      menu.hidden = false;
      esc.querySelector("[data-menu-encima]").textContent = cfg.encima ? "sí" : "no";
      esc.querySelector("[data-menu-juntos]").textContent = cfg.juntos ? "sí" : "no";
      esc.querySelector('[data-menu-item="ocultar"]').textContent = `Ocultar ${bicho.proyecto}`;
    }
    document.addEventListener("pointerdown", (e) => {
      if (!menu.hidden && !menu.contains(e.target)) menu.hidden = true;
    });
    menu.addEventListener("click", (e) => {
      const item = e.target.closest("[data-menu-item]");
      if (!item) return;
      menu.hidden = true;
      const que = item.dataset.menuItem;
      if (que === "terminal" && objetivo) irALaTerminal(objetivo);
      if (que === "panel") abrirPanel();
      if (que === "encima") aplicar("encima", !cfg.encima);
      if (que === "juntos") cfg.juntos = !cfg.juntos;
      if (que === "ocultar" && objetivo) {
        objetivo.oculto = true;
        objetivo.aplicarVisibilidad();
        bandejaTxt.textContent = "Mostrar todos";
      }
      if (que === "mostrar") mostrarTodos();
    });

    function mostrarTodos() {
      bichos.forEach((b) => {
        b.oculto = false;
        b.aplicarVisibilidad();
      });
      bandejaTxt.textContent = "Bichito";
    }

    function abrirPanel() {
      panel.hidden = false;
      activar("panel");
    }
    esc.querySelector("[data-cerrar-panel]").addEventListener("click", () => {
      panel.hidden = true;
      activar("term");
    });

    // --------------------------------------------------------- toggles
    function aplicar(clave, valor) {
      cfg[clave] = valor;
      const casilla = esc.querySelector(`[data-cfg="${clave}"]`);
      if (casilla) casilla.checked = valor;
      if (clave === "pet") {
        bichos.forEach((b) => b.aplicarVisibilidad());
        bandejaTxt.textContent = valor ? "Bichito" : "Mostrar bichitos";
      }
      if (clave === "encima") bichos.forEach((b) => (b.el.dataset.atras = valor ? "0" : "1"));
      bichos.forEach((b) => b.pintarTexto());
    }
    esc.querySelectorAll("[data-cfg]").forEach((c) => {
      c.checked = cfg[c.dataset.cfg];
      c.addEventListener("change", () => aplicar(c.dataset.cfg, c.checked));
    });

    esc.querySelector("[data-bandeja]").addEventListener("click", () => {
      if (bichos.some((b) => b.oculto)) mostrarTodos();
      else aplicar("pet", !cfg.pet);
    });

    // ----------------------------------------------------------- mando
    esc.querySelectorAll("[data-accion]").forEach((b) =>
      b.addEventListener("click", () => {
        const que = b.dataset.accion;
        const bicho = que === "otro" ? bichos[1] : bichos[0];
        bicho.corriendo = false;
        correrTurno(bicho, que !== "turno");
      }),
    );

    // ----------------------------------------------------------- reloj
    const tic = () => {
      const d = new Date();
      reloj.textContent = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
    };
    tic();
    setInterval(tic, 20000);

    // -------------------------------------------------------- arranque
    bichos.forEach((b) => {
      b.acomodar();
      b.set("dormido");
    });
    addEventListener("resize", () => bichos.forEach((b) => b.poner(b.home.x, b.home.y)));

    bichos[0].linea("hook", "SessionStart → bichito-hook.exe idle --launch");
    bichos[0].linea("tool", "dos Claude abiertos, dos bichitos 👇");
    bichos[1].linea("hook", "SessionStart → idle --launch");
    bichos[1].linea("tool", "esta sesión está dormida");

    function loop() {
      bichos.forEach((b) => {
        b.deslizar();
        if (b.desde) b.pintarTexto();
      });
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);

    // al entrar en pantalla, un turno solo para que se vea vivo
    {
      const io = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((x) => x.isIntersecting)) {
            io.disconnect();
            luego(() => correrTurno(bichos[0], true), 900);
          }
        },
        { threshold: 0.15 },
      );
      io.observe(esc);
    }
  })();
</script>
