---
/**
 * El escritorio jugable: una réplica del bichito que hace todo lo que hace el
 * de verdad. Arrastralo, clickealo, abrile el menú, prendé y apagá cosas en el
 * panel, y mandale una tarea a la terminal falsa para verlo trabajar.
 *
 * Es la hero de la página a propósito: contar por escrito lo que hace una
 * mascota de escritorio es peor que dejar que la manotees.
 */
import meta from "../../public/sprites/meta.json";

const ALTO = 190;
const escala = ALTO / meta.h;
const ANCHO = Math.round(meta.w * escala);

const toggles = [
  { id: "pet", label: "Bichito flotante" },
  { id: "timer", label: "Cronómetro" },
  { id: "voz", label: "Voz" },
  { id: "centrar", label: "Saltar al centro" },
  { id: "encima", label: "Siempre encima" },
  { id: "plan5", label: "% plan 5h" },
  { id: "planSem", label: "% plan semanal" },
];
---

<div class="esc" data-esc>
  <div class="esc__marco">
    <div class="esc__pantalla" data-pantalla>
      <div class="esc__fondo" aria-hidden="true"></div>

      <!-- ---------------------------------------------------- terminal -->
      <article class="vent vent--term esc-activa" data-vent="term">
        <header class="vent__barra" data-mover="term">
          <span class="vent__semaforo" aria-hidden="true"></span>
          <span class="vent__tit mini">Windows Terminal — claude</span>
        </header>
        <div class="vent__cuerpo" data-consola role="log" aria-live="polite"></div>
      </article>

      <!-- ------------------------------------------------------- panel -->
      <article class="vent vent--panel" data-vent="panel" hidden>
        <header class="vent__barra" data-mover="panel">
          <span class="vent__semaforo" aria-hidden="true"></span>
          <span class="vent__tit mini">Bichito — panel</span>
          <button class="vent__cerrar" data-cerrar-panel aria-label="Cerrar el panel">×</button>
        </header>
        <div class="vent__cuerpo vent__cuerpo--panel">
          <ul class="panel__lista">
            {
              toggles.map(({ id, label }) => (
                <li class="panel__fila">
                  <label class="panel__label">
                    <input type="checkbox" data-cfg={id} />
                    <span class="panel__pista" aria-hidden="true"><span class="panel__perilla" /></span>
                    <span>{label}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- ----------------------------------------------------- bichito -->
      <div
        class="bic"
        data-bic
        role="button"
        tabindex="0"
        aria-label="El bichito. Clickealo para ir a la terminal, arrastralo para moverlo, botón derecho para el menú."
      >
        <div
          class="bic__sprite sprite pixel"
          data-sprite
          style={`width:${ANCHO}px;height:${ALTO}px`}
        >
        </div>
        <div class="bic__texto">
          <span class="bic__label hud hud-sombra" data-label></span>
          <span class="bic__uso hud hud-sombra" data-uso></span>
        </div>
      </div>

      <!-- globo de la voz: lo que diría en voz alta -->
      <div class="globo mini" data-globo hidden></div>

      <!-- menú de botón derecho -->
      <ul class="menu" data-menu hidden role="menu">
        <li><button role="menuitem" data-menu-item="panel">Abrir panel</button></li>
        <li><button role="menuitem" data-menu-item="encima">Siempre encima <span data-menu-encima>sí</span></button></li>
        <li class="menu__raya" role="separator"></li>
        <li><button role="menuitem" data-menu-item="ocultar">Ocultar bichito</button></li>
        <li><button role="menuitem" data-menu-item="salir">Salir del todo</button></li>
      </ul>

      <!-- barra de tareas, con la bandeja -->
      <footer class="barra">
        <button class="barra__bandeja" data-bandeja>
          <span class="barra__icono pixel" aria-hidden="true"></span>
          <span class="mini" data-bandeja-txt>Bichito</span>
        </button>
        <span class="barra__reloj mini" data-reloj></span>
      </footer>
    </div>
  </div>

  <!-- ------------------------------------------------------------ mando -->
  <div class="mando">
    <div class="mando__grupo">
      <span class="mando__titulo mini">Mandale trabajo</span>
      <button class="btn btn--clay" data-accion="turno">Pedile una tarea</button>
      <button class="btn" data-accion="pregunta">Que te haga una pregunta</button>
    </div>
    <div class="mando__grupo">
      <span class="mando__titulo mini">O forzá un estado</span>
      <button class="btn btn--chico" data-estado="cocinando">Cocinando</button>
      <button class="btn btn--chico" data-estado="esperando">Te espera</button>
      <button class="btn btn--chico" data-estado="termino">Listo</button>
      <button class="btn btn--chico" data-estado="dormido">Dormido</button>
    </div>
  </div>

  <p class="esc__pie">
    Arrastralo · clickealo para ir a la terminal · botón derecho para el menú
  </p>
</div>

<style is:global>
  /* ==================================================================== */
  /*  El escritorio. Todo el CSS del componente va global porque el guion  */
  /*  crea nodos (líneas de consola, chispas) que no llevan el atributo    */
  /*  de scope de Astro y con estilos scopeados quedarían sin pintar.      */
  /* ==================================================================== */
  .esc {
    --marco: 0.75rem;
  }

  .esc__marco {
    border: 1px solid var(--color-ink-line);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #221c16, #171310);
    padding: var(--marco);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 60px -30px rgb(0 0 0 / 0.9);
  }

  .esc__pantalla {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #0f0d0b;
    height: clamp(23rem, 38vw, 26rem);
    user-select: none;
  }

  /* el fondo de pantalla: brasa arriba a la derecha, grilla de píxeles y viñeta */
  .esc__fondo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 88% 8%, #d9775726 0%, transparent 70%),
      radial-gradient(70% 60% at 10% 100%, #f0b4291a 0%, transparent 65%),
      linear-gradient(160deg, #191410 0%, #0e0c0a 100%);
  }
  .esc__fondo::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, #ffffff08 1px, transparent 1px),
      linear-gradient(to bottom, #ffffff08 1px, transparent 1px);
    background-size: 16px 16px;
    mask-image: radial-gradient(80% 70% at 50% 40%, #000 0%, transparent 100%);
  }

  /* --------------------------------------------------------- ventanas -- */
  .vent {
    position: absolute;
    left: var(--x, 2rem);
    top: var(--y, 2.5rem);
    width: var(--w, min(34rem, 58%));
    border: 1px solid var(--color-slate-line);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-slate) 92%, transparent);
    backdrop-filter: blur(2px);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.85);
    z-index: 10;
    transition: box-shadow 0.2s, border-color 0.2s, opacity 0.2s;
    opacity: 0.82;
  }
  .vent.esc-activa {
    z-index: 20;
    opacity: 1;
    border-color: color-mix(in srgb, var(--color-clay) 55%, var(--color-slate-line));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-clay) 25%, transparent),
      0 28px 56px -20px rgb(0 0 0 / 0.9);
  }

  .vent__barra {
    touch-action: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--color-slate-line);
    background: var(--color-slate-soft);
    border-radius: 0.55rem 0.55rem 0 0;
    cursor: grab;
  }
  .vent__barra:active {
    cursor: grabbing;
  }
  .vent__semaforo {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-ash);
    box-shadow: 0.75rem 0 0 #3b4350, 1.5rem 0 0 #3b4350;
    margin-right: 1.5rem;
  }
  .esc-activa .vent__semaforo {
    background: var(--color-clay);
  }
  .vent__tit {
    color: var(--color-ash);
    font-size: 0.625rem;
  }
  .esc-activa .vent__tit {
    color: var(--color-cream);
  }
  .vent__cerrar {
    margin-left: auto;
    color: var(--color-ash);
    line-height: 1;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
  }
  .vent__cerrar:hover {
    color: var(--color-cream);
    background: #ffffff12;
  }

  .vent__cuerpo {
    padding: 0.85rem 0.95rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: #b9c2cd;
    height: 14rem;
    overflow: hidden auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-slate-line) transparent;
  }
  .vent__cuerpo--panel {
    height: auto;
    font-family: var(--font-sans);
    color: var(--color-cream);
  }

  /* líneas de la consola */
  .lin {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .lin--user {
    color: var(--color-cream);
  }
  .lin--user::before {
    content: "› ";
    color: var(--color-clay);
  }
  .lin--tool {
    color: #7d8a99;
  }
  .lin--tool b {
    color: #9db1c7;
    font-weight: 400;
  }
  .lin--ok {
    color: #86b06f;
  }
  .lin--hook {
    color: var(--color-clay);
    opacity: 0.75;
    font-size: 0.6875rem;
  }
  .lin--preg {
    margin: 0.4rem 0 0.2rem;
    padding: 0.55rem 0.7rem;
    border-left: 2px solid var(--color-clay);
    background: #d9775714;
    color: var(--color-cream);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.35rem 0 0.2rem;
  }
  .opcion {
    border: 1px solid var(--color-slate-line);
    border-radius: 0.4rem;
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-cream);
    background: #ffffff08;
  }
  .opcion:hover {
    border-color: var(--color-clay);
    color: var(--color-clay-soft);
  }
  .cursor::after {
    content: "▌";
    color: var(--color-clay);
    animation: parpadeo 1.1s steps(2) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* ----------------------------------------------------------- panel -- */
  .vent--panel {
    --w: min(17rem, 54%);
  }
  .panel__lista {
    display: grid;
    gap: 0.15rem;
  }
  .panel__fila {
    border-radius: 0.4rem;
  }
  .panel__fila:hover {
    background: #ffffff08;
  }
  .panel__label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.4rem;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .panel__label input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .panel__pista {
    width: 1.85rem;
    height: 1.05rem;
    border-radius: 999px;
    background: #ffffff14;
    border: 1px solid var(--color-slate-line);
    display: inline-flex;
    align-items: center;
    padding: 0 2px;
    transition: background 0.15s, border-color 0.15s;
    flex: none;
  }
  .panel__perilla {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--color-ash);
    transition: transform 0.15s, background 0.15s;
  }
  .panel__label input:checked + .panel__pista {
    background: color-mix(in srgb, var(--color-clay) 35%, transparent);
    border-color: var(--color-clay);
  }
  .panel__label input:checked + .panel__pista .panel__perilla {
    transform: translateX(0.8rem);
    background: var(--color-clay);
  }
  .panel__label input:focus-visible + .panel__pista {
    outline: 2px solid var(--color-clay);
    outline-offset: 2px;
  }

  /* --------------------------------------------------------- bichito -- */
  .bic {
    touch-action: none;
    position: absolute;
    left: var(--bx, 60%);
    top: var(--by, 12%);
    z-index: 30;
    display: grid;
    justify-items: center;
    cursor: grab;
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.55));
  }
  .bic[data-atras="1"] {
    z-index: 5;
  }
  /* mientras te espera, un resplandor que respira: es lo que en la app hace el
     salto al centro, llamarte la atención sin taparte nada */
  .bic::before {
    content: "";
    position: absolute;
    inset: -25% -30%;
    background: radial-gradient(circle at 50% 42%, #d9775745, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .bic[data-espera="1"]::before {
    opacity: 1;
    animation: latir 2.4s ease-in-out infinite;
  }
  @keyframes latir {
    50% {
      opacity: 0.4;
    }
  }
  .bic:active {
    cursor: grabbing;
  }
  .bic[hidden] {
    display: none;
  }
  .bic__texto {
    display: grid;
    justify-items: center;
    gap: 1px;
    margin-top: -2px;
    pointer-events: none;
  }
  .bic__label {
    color: var(--color-cream);
    font-size: 0.875rem;
  }
  .bic__uso {
    color: var(--color-tan);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .bic:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 6px;
    border-radius: 0.5rem;
  }

  /* chispas del festejo */
  .chispa {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--color-ember);
    z-index: 29;
    animation: chispa 0.9s ease-out forwards;
  }
  @keyframes chispa {
    to {
      transform: translate(var(--dx), var(--dy)) scale(0.4);
      opacity: 0;
    }
  }

  /* ------------------------------------------------------ globo y menú */
  .globo {
    position: absolute;
    z-index: 40;
    max-width: 15rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--color-ink-line);
    border-radius: 0.5rem;
    background: #241d17f2;
    color: var(--color-cream);
    font-size: 0.625rem;
    line-height: 1.5;
    pointer-events: none;
  }
  .globo[hidden] {
    display: none;
  }
  .globo::before {
    content: "♪ ";
    color: var(--color-clay);
  }

  .menu {
    position: absolute;
    z-index: 50;
    min-width: 11rem;
    padding: 0.25rem;
    border: 1px solid var(--color-ink-line);
    border-radius: 0.5rem;
    background: #221c16f5;
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.9);
  }
  .menu[hidden] {
    display: none;
  }
  .menu button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-radius: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-cream);
  }
  .menu button:hover {
    background: var(--color-clay);
    color: var(--color-ink);
  }
  .menu__raya {
    height: 1px;
    margin: 0.25rem 0.3rem;
    background: var(--color-ink-line);
  }

  /* ---------------------------------------------------------- barra --- */
  .barra {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.6rem;
    background: #0d0b09d9;
    border-top: 1px solid #ffffff10;
    backdrop-filter: blur(4px);
  }
  .barra__bandeja {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--color-ash);
  }
  .barra__bandeja:hover {
    background: #ffffff10;
    color: var(--color-cream);
  }
  .barra__icono {
    width: 14px;
    height: 14px;
    background: url("/favicon.png") center / contain no-repeat;
  }
  .barra__reloj {
    color: var(--color-ash);
    font-size: 0.625rem;
  }

  /* ----------------------------------------------------------- mando -- */
  .mando {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: 1.1rem;
  }
  .mando__grupo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .mando__titulo {
    color: var(--color-ash);
    font-size: 0.625rem;
    margin-right: 0.15rem;
  }

  .btn {
    border: 1px solid var(--color-ink-line);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-cream);
    background: var(--color-ink-soft);
    transition: border-color 0.15s, color 0.15s, transform 0.1s;
  }
  .btn:hover {
    border-color: var(--color-clay);
    color: var(--color-clay-soft);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--clay {
    background: var(--color-clay);
    border-color: var(--color-clay);
    color: #1a120d;
    font-weight: 600;
  }
  .btn--clay:hover {
    filter: brightness(1.08);
    color: #1a120d;
  }
  .btn--chico {
    padding: 0.3rem 0.65rem;
    font-size: 0.8125rem;
  }
  .btn[aria-pressed="true"] {
    border-color: var(--color-clay);
    color: var(--color-clay);
  }

  .esc__pie {
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }

  @media (max-width: 640px) {
    .vent--term {
      --w: 88%;
    }
    .vent__cuerpo {
      height: 11rem;
    }
    .vent--panel {
      --w: 78%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chispa {
      display: none;
    }
  }
</style>

<script define:vars={{ meta, ALTO, ANCHO }}>
  (() => {
    const esc = document.querySelector("[data-esc]");
    if (!esc) return;

    const pantalla = esc.querySelector("[data-pantalla]");
    const bic = esc.querySelector("[data-bic]");
    const sprite = esc.querySelector("[data-sprite]");
    const elLabel = esc.querySelector("[data-label]");
    const elUso = esc.querySelector("[data-uso]");
    const consola = esc.querySelector("[data-consola]");
    const menu = esc.querySelector("[data-menu]");
    const globo = esc.querySelector("[data-globo]");
    const panel = esc.querySelector('[data-vent="panel"]');
    const term = esc.querySelector('[data-vent="term"]');
    const reloj = esc.querySelector("[data-reloj]");
    const bandejaTxt = esc.querySelector("[data-bandeja-txt]");

    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // texto de cada estado, igual que en la app
    const TEXTO = { cocinando: "Cocinando", esperando: "Te espera", termino: "Listo", dormido: "" };

    const cfg = { pet: true, timer: true, voz: false, centrar: true, encima: true, plan5: true, planSem: true };

    const S = {
      estado: "dormido",
      desde: 0,
      congelado: "",
      pinned: false,      // lo arrastraste durante esta espera
      home: { x: 0, y: 0 },
      pos: { x: 0, y: 0 },
      corriendo: false,   // hay un turno en curso
      paso: 0,
      timers: [],
    };

    // ------------------------------------------------------------ ayudas
    const fmt = (s) => {
      s = Math.max(0, Math.floor(s));
      return s >= 60 ? `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, "0")}s` : `${s}s`;
    };
    const luego = (fn, ms) => S.timers.push(setTimeout(fn, ms));
    const limpiarTimers = () => {
      S.timers.forEach(clearTimeout);
      S.timers = [];
    };

    function medidas() {
      const r = pantalla.getBoundingClientRect();
      return {
        w: r.width,
        h: r.height,
        alto: bic.offsetHeight || ALTO + 34,
        ancho: bic.offsetWidth || ANCHO,
      };
    }

    function centro() {
      const m = medidas();
      return { x: (m.w - m.ancho) / 2, y: (m.h - m.alto) / 2 - 10 };
    }

    function poner(x, y) {
      const m = medidas();
      S.pos.x = Math.min(Math.max(x, 4), m.w - m.ancho - 4);
      S.pos.y = Math.min(Math.max(y, 4), m.h - m.alto - 26);
      bic.style.setProperty("--bx", `${S.pos.x}px`);
      bic.style.setProperty("--by", `${S.pos.y}px`);
    }

    // ------------------------------------------------------- el sprite
    function pintarSprite() {
      const nombre = S.estado === "dormido" ? "dormido" : S.estado;
      const info = meta[nombre];
      const tira = ANCHO * info.frames;
      sprite.style.backgroundImage = `url(/sprites/${nombre}.png)`;
      sprite.style.setProperty("--strip", `${tira}px`);
      sprite.style.setProperty("--frames", info.frames);
      sprite.style.setProperty("--dur", `${(info.frames / info.fps).toFixed(2)}s`);
      sprite.classList.toggle("sprite--once", nombre === "termino");
      // reiniciar la animación al cambiar de estado
      sprite.style.animation = "none";
      void sprite.offsetWidth;
      sprite.style.animation = "";
    }

    function pintarTexto() {
      let label = "";
      if (S.estado === "termino") label = cfg.timer && S.congelado ? `Listo  ${S.congelado}` : "Listo";
      else {
        const base = TEXTO[S.estado] || "";
        label = base && S.desde && cfg.timer ? `${base}  ${fmt((Date.now() - S.desde) / 1000)}` : base;
      }
      elLabel.textContent = label;
      const partes = [];
      if (cfg.plan5) partes.push("5h 24%");
      if (cfg.planSem) partes.push("sem 78%");
      elUso.textContent = partes.join("  ");
    }

    function estado(nuevo, opciones = {}) {
      if (nuevo !== S.estado) {
        if (nuevo !== "esperando") S.pinned = false;
        S.estado = nuevo;
        bic.dataset.espera = nuevo === "esperando" ? "1" : "0";
        pintarSprite();
      }
      if (nuevo === "cocinando" && !opciones.mantener) S.desde = Date.now();
      if (nuevo === "dormido") S.desde = 0;
      pintarTexto();
    }

    // ---------------------------------------------------------- deslizar
    function deslizar() {
      const destino = S.estado === "esperando" && cfg.centrar && !S.pinned ? centro() : S.home;
      const dx = destino.x - S.pos.x;
      const dy = destino.y - S.pos.y;
      if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) poner(destino.x, destino.y);
      else poner(S.pos.x + dx * (quieto ? 1 : 0.18), S.pos.y + dy * (quieto ? 1 : 0.18));
      if (S.estado !== "dormido" || S.desde) pintarTexto();
      if (!globo.hidden) ponerGlobo();
      requestAnimationFrame(deslizar);
    }

    // -------------------------------------------------------------- voz
    function ponerGlobo() {
      const m = medidas();
      globo.style.left = `${Math.max(Math.min(S.pos.x - 20, m.w - globo.offsetWidth - 8), 8)}px`;
      globo.style.top = `${Math.max(S.pos.y - globo.offsetHeight - 8, 6)}px`;
    }

    function decir(texto) {
      globo.textContent = texto;
      globo.hidden = false;
      ponerGlobo();
      luego(() => (globo.hidden = true), 3200);
      if (cfg.voz && "speechSynthesis" in window) {
        try {
          const v = new SpeechSynthesisUtterance(texto);
          v.lang = "es-AR";
          v.rate = 1.05;
          speechSynthesis.cancel();
          speechSynthesis.speak(v);
        } catch {
          /* si el navegador no quiere hablar, queda el globo */
        }
      }
    }

    // ---------------------------------------------------------- consola
    function linea(clase, html) {
      const p = document.createElement("p");
      p.className = `lin lin--${clase}`;
      p.innerHTML = html;
      consola.appendChild(p);
      consola.scrollTop = consola.scrollHeight;
      return p;
    }

    function activar(cual) {
      term.classList.toggle("esc-activa", cual === "term");
      panel.classList.toggle("esc-activa", cual === "panel");
    }

    // -------------------------------------------------------- el guion
    const TAREA = [
      { c: "tool", t: "<b>Read</b>  bichito_pet.py" },
      { c: "tool", t: "<b>Grep</b>  _draw_text" },
      { c: "tool", t: "<b>Edit</b>  bichito_pet.py  +12 −4" },
      { c: "tool", t: "<b>Bash</b>  python build.py" },
    ];

    function correrTurno(conPregunta) {
      if (S.corriendo) return;
      limpiarTimers();
      S.corriendo = true;
      consola.innerHTML = "";
      linea("user", conPregunta ? "arreglá el layout del % del plan" : "compilá y dejámelo instalado");
      linea("hook", "UserPromptSubmit → bichito-hook.exe working");
      estado("cocinando");
      activar("term");

      let t = 500;
      TAREA.forEach((l, i) => {
        luego(() => {
          linea(l.c, l.t);
          linea("hook", "PreToolUse → working");
        }, t);
        t += 800;
        if (conPregunta && i === 1) {
          luego(() => preguntar(), t);
          t += 400;
        }
      });
      if (!conPregunta) luego(terminar, t + 300);
    }

    function preguntar() {
      // en la app esto lo dispara el PreToolUse de AskUserQuestion
      limpiarTimers();
      linea("hook", "PreToolUse AskUserQuestion → waiting");
      linea("preg", "¿La franja del uso va abajo del label, o arriba?");
      const caja = document.createElement("div");
      caja.className = "opciones";
      ["Abajo", "Arriba"].forEach((op) => {
        const b = document.createElement("button");
        b.className = "opcion";
        b.textContent = op;
        b.addEventListener("click", () => {
          caja.remove();
          linea("user", op.toLowerCase());
          estado("cocinando", { mantener: true });
          linea("hook", "UserPromptSubmit → working");
          luego(() => linea("tool", "<b>Edit</b>  bichito_pet.py  +8 −3"), 600);
          luego(terminar, 1600);
        });
        caja.appendChild(b);
      });
      consola.appendChild(caja);
      consola.scrollTop = consola.scrollHeight;
      estado("esperando", { mantener: true });
      decir("El proyecto bichito está esperando tu respuesta");
    }

    function terminar() {
      S.congelado = fmt((Date.now() - S.desde) / 1000);
      linea("ok", "listo, el uso quedó en su propia franja");
      linea("hook", "Stop → bichito-hook.exe idle");
      estado("termino");
      decir("El proyecto bichito terminó");
      chispas();
      luego(() => {
        estado("dormido");
        S.corriendo = false;
      }, 2400);
    }

    function chispas() {
      if (quieto) return;
      const m = medidas();
      for (let i = 0; i < 14; i++) {
        const c = document.createElement("i");
        c.className = "chispa";
        c.style.left = `${S.pos.x + m.ancho / 2}px`;
        c.style.top = `${S.pos.y + 40}px`;
        c.style.setProperty("--dx", `${(Math.random() - 0.5) * 150}px`);
        c.style.setProperty("--dy", `${-Math.random() * 110 - 20}px`);
        c.style.animationDelay = `${Math.random() * 0.25}s`;
        pantalla.appendChild(c);
        setTimeout(() => c.remove(), 1300);
      }
    }

    // ------------------------------------------------------- arrastrar
    function arrastrable(el, alSoltarClick) {
      let id = null;
      let ini = null;
      let movido = false;
      el.addEventListener("pointerdown", (e) => {
        if (e.button === 2) return;
        id = e.pointerId;
        movido = false;
        const r = el.getBoundingClientRect();
        const p = pantalla.getBoundingClientRect();
        ini = { dx: e.clientX - r.left, dy: e.clientY - r.top, px: p.left, py: p.top, x: e.clientX, y: e.clientY };
        try {
          el.setPointerCapture(id);
        } catch {
          /* sin captura el arrastre igual anda mientras el puntero no se vaya */
        }
      });
      el.addEventListener("pointermove", (e) => {
        if (id === null || e.pointerId !== id) return;
        if (!movido) {
          // el mismo umbral que la app: un click nunca sale perfectamente quieto
          if (Math.abs(e.clientX - ini.x) < 4 && Math.abs(e.clientY - ini.y) < 4) return;
          movido = true;
        }
        const x = e.clientX - ini.px - ini.dx;
        const y = e.clientY - ini.py - ini.dy;
        if (el === bic) {
          poner(x, y);
          S.home = { ...S.pos };
          S.pinned = true;   // arrastrar gana: el centro deja de tironear
        } else {
          el.style.setProperty("--x", `${x}px`);
          el.style.setProperty("--y", `${y}px`);
        }
      });
      const soltar = (e) => {
        if (id === null || (e.pointerId !== undefined && e.pointerId !== id)) return;
        try {
          el.releasePointerCapture(id);
        } catch {}
        id = null;
        if (!movido && alSoltarClick) alSoltarClick();
      };
      el.addEventListener("pointerup", soltar);
      el.addEventListener("pointercancel", soltar);
    }

    // click limpio en el bichito: te lleva a la terminal
    function irALaTerminal() {
      activar("term");
      term.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.012)" }, { transform: "scale(1)" }],
        { duration: 260, easing: "ease-out" },
      );
      decir("te llevo a la terminal");
      globo.textContent = "click → la terminal de esa sesión pasa al frente";
    }

    arrastrable(bic, irALaTerminal);
    esc.querySelectorAll("[data-mover]").forEach((barra) => {
      const vent = barra.closest(".vent");
      arrastrable(barra, () => activar(vent.dataset.vent));
      vent.addEventListener("pointerdown", () => activar(vent.dataset.vent));
    });

    bic.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        irALaTerminal();
      }
    });

    // ------------------------------------------------------------ menú
    bic.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      const p = pantalla.getBoundingClientRect();
      menu.style.left = `${Math.min(e.clientX - p.left, p.width - 190)}px`;
      menu.style.top = `${Math.min(e.clientY - p.top, p.height - 150)}px`;
      menu.hidden = false;
      esc.querySelector("[data-menu-encima]").textContent = cfg.encima ? "sí" : "no";
    });
    document.addEventListener("pointerdown", (e) => {
      if (!menu.hidden && !menu.contains(e.target)) menu.hidden = true;
    });
    menu.addEventListener("click", (e) => {
      const item = e.target.closest("[data-menu-item]");
      if (!item) return;
      menu.hidden = true;
      const que = item.dataset.menuItem;
      if (que === "panel") abrirPanel();
      if (que === "encima") aplicar("encima", !cfg.encima);
      if (que === "ocultar") aplicar("pet", false);
      if (que === "salir") {
        aplicar("pet", false);
        bandejaTxt.textContent = "Abrir Bichito";
      }
    });

    function abrirPanel() {
      panel.hidden = false;
      const m = medidas();
      panel.style.setProperty("--x", `${Math.max(m.w * 0.52, 12)}px`);
      panel.style.setProperty("--y", "3.5rem");
      activar("panel");
    }
    esc.querySelector("[data-cerrar-panel]").addEventListener("click", () => {
      panel.hidden = true;
      activar("term");
    });

    // --------------------------------------------------------- toggles
    function aplicar(clave, valor) {
      cfg[clave] = valor;
      const casilla = esc.querySelector(`[data-cfg="${clave}"]`);
      if (casilla) casilla.checked = valor;
      if (clave === "pet") {
        bic.hidden = !valor;
        bandejaTxt.textContent = valor ? "Bichito" : "Mostrar bichito";
      }
      if (clave === "encima") bic.dataset.atras = valor ? "0" : "1";
      pintarTexto();
    }
    esc.querySelectorAll("[data-cfg]").forEach((c) => {
      c.checked = cfg[c.dataset.cfg];
      c.addEventListener("change", () => aplicar(c.dataset.cfg, c.checked));
    });

    esc.querySelector("[data-bandeja]").addEventListener("click", () => {
      aplicar("pet", !cfg.pet);
      bandejaTxt.textContent = cfg.pet ? "Bichito" : "Mostrar bichito";
    });

    // ---------------------------------------------------------- mando
    esc.querySelectorAll("[data-accion]").forEach((b) =>
      b.addEventListener("click", () => {
        S.corriendo = false;
        correrTurno(b.dataset.accion === "pregunta");
      }),
    );
    esc.querySelectorAll("[data-estado]").forEach((b) =>
      b.addEventListener("click", () => {
        limpiarTimers();
        S.corriendo = false;
        const e = b.dataset.estado;
        if (e === "termino") {
          S.congelado = S.desde ? fmt((Date.now() - S.desde) / 1000) : "4m 12s";
          estado("termino");
          chispas();
        } else {
          if (e === "esperando") S.desde = S.desde || Date.now();
          estado(e);
        }
      }),
    );

    // ----------------------------------------------------------- reloj
    const tic = () => {
      const d = new Date();
      reloj.textContent = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
    };
    tic();
    setInterval(tic, 20000);

    // ---------------------------------------------------------- arranque
    function acomodar() {
      const m = medidas();
      S.home = { x: m.w - m.ancho - 28, y: 26 };
      poner(S.home.x, S.home.y);
      term.style.setProperty("--x", "1.5rem");
      term.style.setProperty("--y", "2rem");
    }
    acomodar();
    addEventListener("resize", () => {
      const m = medidas();
      S.home = { x: Math.min(S.home.x, m.w - m.ancho - 8), y: Math.min(S.home.y, m.h - m.alto - 30) };
      poner(S.home.x, S.home.y);
    });

    estado("dormido");
    linea("hook", "SessionStart → bichito-hook.exe idle --launch");
    linea("tool", "el bichito está dormido. Pedile algo a Claude 👇");
    requestAnimationFrame(deslizar);

    // primera visita: al entrar en pantalla, un turno solo para que se vea vivo.
    // Corre también con "reducir movimiento": la demo es el contenido de la
    // página, no un adorno. Lo que se apaga en ese caso es el deslizamiento,
    // el sprite y las chispas.
    {
      const io = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((x) => x.isIntersecting)) {
            io.disconnect();
            luego(() => correrTurno(true), 900);
          }
        },
        { threshold: 0.15 },
      );
      io.observe(esc);
    }
  })();
</script>
