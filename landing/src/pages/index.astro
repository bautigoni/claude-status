---
import fs from "node:fs";
import path from "node:path";

import Base from "../layouts/Base.astro";
import Sprite from "../components/Sprite.astro";

// El peso se lee del archivo real en tiempo de build: escrito a mano quedaria
// desactualizado en cuanto cambie el paquete.
const zip = path.join(process.cwd(), "public", "Bichito.zip");
const descarga = {
  href: "/Bichito.zip",
  nombre: "Bichito.zip",
  peso: fs.existsSync(zip)
    ? `${(fs.statSync(zip).size / 1024 / 1024).toFixed(0)} MB`
    : "—",
};

const estados = [
  {
    state: "cocinando" as const,
    titulo: "Cocinando",
    texto: "Mientras Claude trabaja, el bichito saltea un panqueque y te lleva el cronómetro del turno.",
  },
  {
    state: "esperando" as const,
    titulo: "Te espera",
    texto: "Si te hace una pregunta o pide permiso, salta al centro de la pantalla y te avisa por voz.",
  },
  {
    state: "termino" as const,
    titulo: "Listo",
    texto: "Cuando termina, festeja con el tiempo final congelado. Ese es el momento que no te querés perder.",
  },
  {
    state: "dormido" as const,
    titulo: "Dormido",
    texto: "Después del festejo se acomoda y se duerme, sin robarte atención hasta el próximo turno.",
  },
];

const numeros = [
  { que: "Script de Python suelto", ms: 53, ancho: 21 },
  { que: "Empaquetado con PyInstaller", ms: 249, ancho: 100 },
  { que: "bichito-hook.exe (Rust)", ms: 20, ancho: 8, destacado: true },
];

const pasos = [
  { n: "01", t: "Descargás y descomprimís", d: "Adentro está Bichito.exe. No necesitás tener Python ni Rust instalados." },
  { n: "02", t: "Abrís Bichito.exe y tocás «Instalar en Claude Code»", d: "Se copia a %LOCALAPPDATA%, deja un acceso directo y escribe los hooks." },
  { n: "03", t: "Listo", d: "Aplica al Desktop, a cmd y a PowerShell de una: los tres leen el mismo settings.json." },
];
---

<Base
  title="Bichito — la mascota que te avisa cuándo Claude Code terminó"
  description="Una mascota de escritorio para Claude Code: te muestra si está trabajando, si te está esperando o si ya terminó, sin que mires la terminal."
>
  <!-- ================= HERO ================= -->
  <header class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[36rem] opacity-60 blur-3xl"
      style="background: radial-gradient(45% 50% at 50% 50%, #d9775733 0%, transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-4xl px-6 pt-14 pb-20 text-center sm:pt-20">
      <Sprite state="cocinando" height={190} class="mx-auto" />

      <p
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-ink-line bg-ink-soft px-3.5 py-1.5 text-xs text-ash"
      >
        <span class="size-1.5 rounded-full bg-clay"></span>
        Para Claude Code en Windows
      </p>

      <h1
        class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-6xl"
      >
        Sabé cuándo Claude terminó
        <span class="block text-clay">sin mirar la terminal</span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg text-pretty text-ash sm:text-xl">
        Un bichito que flota en tu escritorio, cocina mientras Claude trabaja y
        te avisa por voz cuando termina o cuando necesita algo tuyo.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={descarga.href}
          download
          class="group inline-flex items-center gap-2.5 rounded-xl bg-clay px-6 py-3 font-semibold text-ink transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay"
        >
          <svg
            class="size-4 transition group-hover:translate-y-0.5"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 1.5v9" />
            <path d="M4.5 7.5 8 11l3.5-3.5" />
            <path d="M2 13.5h12" />
          </svg>
          Descargar para Windows
        </a>
        <a
          href="#como-funciona"
          class="rounded-xl border border-ink-line px-6 py-3 font-medium text-cream transition hover:border-clay hover:text-clay-soft"
        >
          Cómo está hecho
        </a>
      </div>

      <p class="mt-4 font-mono text-xs text-ash">
        {descarga.nombre} · {descarga.peso} · Windows 10/11 · sin dependencias
      </p>
    </div>
  </header>

  <!-- ================= ESTADOS ================= -->
  <section class="mx-auto max-w-6xl px-6 py-20" aria-labelledby="estados">
    <h2 id="estados" class="text-3xl font-semibold tracking-tight sm:text-4xl">
      Cuatro estados, de un vistazo
    </h2>
    <p class="mt-3 max-w-2xl text-ash">
      No hay que leer nada. La pose del bichito ya te dice en qué anda.
    </p>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        estados.map(({ state, titulo, texto }) => (
          <li class="group rounded-2xl border border-ink-line bg-ink-soft p-5 transition hover:border-clay/50">
            <div class="flex h-32 items-end justify-center">
              <Sprite state={state} height={120} />
            </div>
            <h3 class="mt-4 font-semibold text-clay">{titulo}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ash">{texto}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= COMO FUNCIONA ================= -->
  <section
    id="como-funciona"
    class="border-y border-ink-line bg-ink-soft/40"
    aria-labelledby="como"
  >
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 id="como" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Cómo está hecho
      </h2>
      <p class="mt-3 max-w-2xl text-ash">
        Se engancha a los hooks de Claude Code. Todo lo demás sale de ahí.
      </p>

      <div
        class="mt-10 overflow-x-auto rounded-2xl border border-ink-line bg-ink p-6"
      >
        <pre
          class="font-mono text-sm leading-7 text-ash"><span class="text-clay">hooks de Claude Code</span>  →  <span class="text-cream">bichito-hook.exe</span>  →  <span class="text-ash">state/&lt;sesión&gt;.json</span>  →  <span class="text-clay">el bichito</span>
                            <span class="text-ember">(Rust, 20 ms)</span>                          <span class="text-ash">(lee cada 250 ms)</span></pre>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-ink-line bg-ink p-6">
          <h3 class="font-semibold text-cream">Tu settings.json se toca una vez</h3>
          <p class="mt-2 text-sm leading-relaxed text-ash">
            Los hooks se escriben al instalar y no se vuelven a tocar. Los
            interruptores viven en la config propia de la app, así prender y
            apagar cosas es instantáneo y no hay que hacerle cirugía a un
            archivo que también es tuyo.
          </p>
        </article>
        <article class="rounded-2xl border border-ink-line bg-ink p-6">
          <h3 class="font-semibold text-cream">Alfa real por píxel</h3>
          <p class="mt-2 text-sm leading-relaxed text-ash">
            La ventana se dibuja con <code class="font-mono text-clay">UpdateLayeredWindow</code>.
            Con la transparencia común los bordes suavizados del sprite
            quedarían con un halo del color de fondo.
          </p>
        </article>
        <article class="rounded-2xl border border-ink-line bg-ink p-6">
          <h3 class="font-semibold text-cream">No se queda colgado</h3>
          <p class="mt-2 text-sm leading-relaxed text-ash">
            Si apretás Esc o cerrás la terminal, Claude no avisa que terminó.
            Por eso hay un latido: sin señal por 15 minutos, el bichito se
            duerme solo en vez de cocinar para siempre.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= NUMEROS ================= -->
  <section class="mx-auto max-w-6xl px-6 py-20" aria-labelledby="numeros">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="numeros" class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Por qué el hook está en Rust
        </h2>
        <p class="mt-4 leading-relaxed text-ash">
          Ese binario corre en <strong class="text-cream">cada llamada a
          herramienta</strong>, cientos de veces por sesión. La primera versión
          era un script de Python; empaquetarlo lo volvió cinco veces más lento,
          así que esa parte —y solo esa— se reescribió en Rust.
        </p>
        <p class="mt-4 text-sm text-ash">
          Mediana de 15 corridas, esperando a que el proceso termine de verdad.
        </p>
      </div>

      <ul class="space-y-5">
        {
          numeros.map(({ que, ms, ancho, destacado }) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <span
                  class:list={[
                    "text-sm",
                    destacado ? "font-semibold text-clay" : "text-ash",
                  ]}
                >
                  {que}
                </span>
                <span
                  class:list={[
                    "font-mono text-sm tabular-nums",
                    destacado ? "text-clay" : "text-ash",
                  ]}
                >
                  {ms} ms
                </span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-ink-soft">
                <div
                  class:list={[
                    "h-full rounded-full",
                    destacado ? "bg-clay" : "bg-ink-line",
                  ]}
                  style={`width:${ancho}%`}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= INSTALAR ================= -->
  <section
    id="instalar"
    class="border-t border-ink-line bg-ink-soft/40"
    aria-labelledby="inst"
  >
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 id="inst" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Instalarlo lleva un click
      </h2>

      <ol class="mt-10 space-y-4">
        {
          pasos.map(({ n, t, d }) => (
            <li class="flex gap-5 rounded-2xl border border-ink-line bg-ink p-5">
              <span class="font-mono text-sm text-clay">{n}</span>
              <div>
                <h3 class="font-semibold text-cream">{t}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ash">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <a
        href={descarga.href}
        download
        class="mt-8 flex items-center justify-between gap-4 rounded-2xl border border-clay/40 bg-clay/10 p-5 transition hover:border-clay hover:bg-clay/15"
      >
        <span class="flex items-center gap-4">
          <Sprite state="termino" height={56} />
          <span>
            <span class="block font-semibold text-cream">Descargar Bichito</span>
            <span class="block font-mono text-xs text-ash">
              {descarga.nombre} · {descarga.peso}
            </span>
          </span>
        </span>
        <span class="rounded-lg bg-clay px-5 py-2.5 text-sm font-semibold text-ink">
          Descargar
        </span>
      </a>

      <p class="mt-6 rounded-xl border border-ink-line bg-ink p-4 text-sm text-ash">
        <strong class="text-cream">WSL queda afuera:</strong> tiene su propio
        <code class="font-mono text-clay">~/.claude</code> en el sistema de archivos
        de Linux, y un comando de Windows no se ejecutaría ahí.
      </p>
    </div>
  </section>

  <!-- ================= PIE ================= -->
  <footer class="border-t border-ink-line">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-10 text-sm text-ash sm:flex-row sm:justify-between"
    >
      <div class="flex items-center gap-3">
        <Sprite state="dormido" height={44} />
        <span>Bichito — hecho para Claude Code</span>
      </div>
      <span class="font-mono text-xs">Astro + Tailwind · Python + Rust</span>
    </div>
  </footer>
</Base>
